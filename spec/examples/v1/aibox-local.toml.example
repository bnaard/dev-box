schema = "aibox.local/v1"

[targets.remote-dev]
host = "dev.example.invalid"
user = "developer"
sshIdentity = "os-keychain:work-ssh"

[providers.developer-sops]
type = "sops"
source = "./secrets/developer.sops.yaml"
identity = "os-keychain:aibox-sops-age"
decryptOn = "local"

[providers.team-openbao]
type = "openbao"
address = "https://bao.example.invalid"
auth = "oidc"

[overrides.compose]
local = "./docker-compose.override.yaml"
# A remote-native alternative is explicit and participates in provenance.
# remote = "~/.config/aibox/remote-dev.compose.override.yaml"
