layout {
    tab_template name="aibox-tab" {
        children
        pane size=1 borderless=true {
            plugin location="file:/usr/local/share/aibox/zellij/aibox-status.wasm" {
                role "keys"
            }
        }
        pane size=1 borderless=true {
            plugin location="file:/usr/local/share/aibox/zellij/aibox-status.wasm" {
                role "status"
            }
        }
    }
    aibox-tab name="dev" focus=true {
        pane split_direction="vertical" {
            pane size="40%" name="files" focus=true {
                command "yazi"
                cwd "/workspace"
            }
            pane size="60%" name="editor" {
                command "vim-loop"
                cwd "/workspace"
            }
        }
    }
    aibox-tab name="codex" {
        pane name="codex" {
            command "codex"
            cwd "/workspace"
            start_suspended true
        }
    }
    aibox-tab name="shell" {
        pane name="bash" {
            command "bash"
            cwd "/workspace"
            start_suspended true
        }
    }
}
