{{ header }}#
# =============================================================================
# HOW TO CUSTOMIZE:
#   Do NOT edit this file directly — it is regenerated by `aibox apply`.
#   To add ports/volumes/env vars: use docker-compose.override.yml
#   To change user:     set user in aibox.toml [container], run `aibox apply`
#
# VOLUME MOUNT STRATEGY:
#   Config files (vim, zellij, yazi, git, AI tools) are mounted read-write from
#   the host-side .aibox-home/ directory so changes persist across rebuilds.
#   The workspace (project root) is mounted at /workspace inside the container.
#   SSH keys are mounted read-only for security.
# =============================================================================
#
name: {{ project_name }}

services:
  {{ name }}:
    build:
      context: .
      dockerfile: {{ dockerfile_path }}
    image: {{ image_name }}
    container_name: {{ name }}
    hostname: {{ hostname }}
    init: true
{% if codex_sandbox_seccomp %}
    # Codex CLI uses bubblewrap for Linux sandboxing. Some container
    # runtime seccomp profiles block unprivileged user namespace creation
    # before bubblewrap can set up its own sandbox. This narrow fallback
    # avoids privileged=true and SYS_ADMIN.
    security_opt:
      - seccomp=unconfined
{% endif %}
    stdin_open: true
    tty: true
    working_dir: /workspace
    volumes:
      # Workspace (project root)
      - ${WORKSPACE_DIR:-{{ workspace_dir }}}:/workspace
      # SSH keys (read-only — mount from host)
      - {{ host_root }}/.ssh:{{ container_home }}/.ssh:ro
      # Vim configuration (vimrc + undo only — colorschemes stay from image)
      - {{ host_root }}/.vim/vimrc:{{ container_home }}/.vim/vimrc
      - {{ host_root }}/.vim/undo:{{ container_home }}/.vim/undo
      # Zellij terminal multiplexer config
      - {{ host_root }}/.config/zellij:{{ container_home }}/.config/zellij
      # XDG cache home. This must be mounted as a writable parent, not only as
      # selected subdirectories, because tools such as uv and starship create
      # their own cache/log directories at runtime. It also carries Zellij's
      # pre-seeded sidecar plugin permission cache.
      - {{ host_root }}/.cache:{{ container_home }}/.cache
      # Yazi file manager config
      - {{ host_root }}/.config/yazi:{{ container_home }}/.config/yazi
      # Git configuration
      - {{ host_root }}/.config/git:{{ container_home }}/.config/git
      # XDG state for TUIs such as lazygit
      - {{ host_root }}/.config/state:{{ container_home }}/.config/state
      # aibox-managed helper scripts (resource status, preview helpers)
      - {{ host_root }}/.local/bin:{{ container_home }}/.local/bin
{% for harness in ai_providers %}
{% if harness == "claude" %}
      # Claude Code configuration and memory
      - {{ host_root }}/.claude:{{ container_home }}/.claude
      # Claude Code account/session state (holds oauthAccount, userID);
      # mounting .claude alone is not enough — without this file Claude Code
      # treats every rebuild as a fresh install and re-prompts for login.
      - {{ host_root }}/.claude.json:{{ container_home }}/.claude.json
{% endif %}
{% if harness == "aider" %}
      # Aider configuration
      - {{ host_root }}/.aider:{{ container_home }}/.aider
{% endif %}
{% if harness == "gemini" %}
      # Gemini CLI configuration
      - {{ host_root }}/.gemini:{{ container_home }}/.gemini
{% endif %}
{% if harness == "codex" %}
      # OpenAI Codex CLI configuration and cached login state
      - {{ host_root }}/.codex:{{ container_home }}/.codex
{% endif %}
{% if harness == "continue" %}
      # Continue configuration
      - {{ host_root }}/.continue:{{ container_home }}/.continue
{% endif %}
{% if harness == "copilot" %}
      # GitHub Copilot CLI configuration
      - {{ host_root }}/.copilot:{{ container_home }}/.copilot
{% endif %}
{% if harness == "opencode" %}
      # OpenCode configuration
      - {{ host_root }}/.opencode:{{ container_home }}/.opencode
{% endif %}
{% if harness == "hermes" %}
      # Hermes agent configuration
      - {{ host_root }}/.hermes:{{ container_home }}/.hermes
{% endif %}
{% endfor %}
{% if audio_enabled %}
      # ALSA → PulseAudio bridge config
      - {{ host_root }}/.asoundrc:{{ container_home }}/.asoundrc
{% endif %}
{% if has_rust %}
      # Cargo registry cache — avoids re-downloading crates on rebuild.
      # Only registry/ and git/ are mounted; bin/ stays in the image (host binaries
      # won't run in the container).
      - {{ host_root }}/.cargo/registry:{{ container_home }}/.cargo/registry
      - {{ host_root }}/.cargo/git:{{ container_home }}/.cargo/git
{% endif %}
{% for vol in extra_volumes %}
{% if vol.read_only %}
      - {{ vol.source }}:{{ vol.target }}:ro
{% else %}
      - {{ vol.source }}:{{ vol.target }}
{% endif %}
{% endfor %}
    env_file:
      # Credentials from .aibox-local.toml — gitignored, never committed.
      # Re-generated by `aibox apply`; may be empty when no local overlay exists.
      - {{ local_env_file }}
    environment:
{% for key in env_keys %}
      {{ key }}: "{{ env_vals[key] }}"
{% endfor %}
    command: sleep infinity

  {{ name }}-diagnostics:
    image: {{ image_name }}
    container_name: {{ name }}-diagnostics
    hostname: {{ hostname }}-diagnostics
    user: root
    init: true
    pid: "service:{{ name }}"
    depends_on:
      - {{ name }}
    working_dir: /workspace
    pids_limit: 64
    mem_limit: 64m
    cpus: 0.20
    restart: "on-failure:3"
    volumes:
      - ${WORKSPACE_DIR:-{{ workspace_dir }}}:/workspace
    command:
      - /usr/local/bin/aibox-diagnostics
      - --watch
      - --output
      - /workspace/.aibox/diagnostics
