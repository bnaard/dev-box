@@ -740,6 +746,116 @@ def run_cross_references(target_or_root: AuditTarget | Path) -> list[Finding]:
     return findings


+# ---------------------------------------------------------------------------
+# Check 5: stale_layout_tests (project-configurable magic-string sweep)
+# ---------------------------------------------------------------------------
+
+_STALE_PATTERNS_RELPATH = (
+    "context/skills/processkit/release-audit/stale-test-patterns.toml"
+)
+
+_DEFAULT_TEST_GLOBS = (
+    "tests/**/*.rs",
+    "tests/**/*.py",
+    "tests/**/*.sh",
+    "**/*_test.rs",
+    "**/*_test.py",
+    "**/*_test.sh",
+)
+
+
+def _load_stale_patterns(repo_root: Path) -> dict | None:
+    cfg = repo_root / _STALE_PATTERNS_RELPATH
+    if not cfg.is_file():
+        return None
+    with cfg.open("rb") as fh:
+        return tomllib.load(fh)
+
+
+def run_stale_layout_tests(target_or_root: AuditTarget | Path) -> list[Finding]:
+    target = _coerce_target(target_or_root)
+    repo_root = target.repo_root
+    findings: list[Finding] = []
+
+    cfg = _load_stale_patterns(repo_root)
+    if cfg is None:
+        findings.append(Finding(
+            severity="INFO",
+            category="stale_layout_tests",
+            id="stale.no-config",
+            message=(
+                "No stale-test-patterns.toml present — check is a no-op. "
+                "Define patterns at " + _STALE_PATTERNS_RELPATH + " to enable."
+            ),
+        ))
+        return findings
+
+    test_globs = cfg.get("test_globs") or list(_DEFAULT_TEST_GLOBS)
+    categories = cfg.get("category") or []
+    if not categories:
+        findings.append(Finding(
+            severity="WARN",
+            category="stale_layout_tests",
+            id="stale.no-categories",
+            message=(
+                _STALE_PATTERNS_RELPATH + " present but defines no [[category]] "
+                "entries — sweep would emit nothing."
+            ),
+        ))
+        return findings
+
+    compiled: list[tuple[str, str, re.Pattern, Optional[re.Pattern]]] = []
+    for cat in categories:
+        name = cat.get("name", "unnamed")
+        desc = cat.get("description", "")
+        pat = cat.get("pattern")
+        sup = cat.get("suppress")
+        if not pat:
+            findings.append(Finding(
+                severity="ERROR",
+                category="stale_layout_tests",
+                id="stale.bad-pattern",
+                message=f"Category {name!r} has no pattern field",
+            ))
+            continue
+        try:
+            compiled.append((
+                name, desc, re.compile(pat),
+                re.compile(sup) if sup else None,
+            ))
+        except re.error as exc:
+            findings.append(Finding(
+                severity="ERROR",
+                category="stale_layout_tests",
+                id="stale.bad-pattern",
+                message=f"Category {name!r} has invalid regex: {exc}",
+            ))
+
+    seen: set[Path] = set()
+    for glob in test_globs:
+        for path in repo_root.glob(glob):
+            if not path.is_file() or path in seen:
+                continue
+            seen.add(path)
+            rel = path.relative_to(repo_root).as_posix()
+            try:
+                text = path.read_text(encoding="utf-8", errors="replace")
+            except OSError:
+                continue
+            for lineno, line in enumerate(text.splitlines(), start=1):
+                for name, desc, pattern, suppress in compiled:
+                    if suppress is not None and suppress.search(line):
+                        continue
+                    if pattern.search(line):
+                        findings.append(Finding(
+                            severity="WARN",
+                            category="stale_layout_tests",
+                            id=f"stale.{name}",
+                            message=f"{rel}:{lineno} matched ({name})",
+                            entity_ref=rel,
+                        ))
+                        break
+
+    return findings
+
+
