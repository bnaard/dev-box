// =============================================================================
// "dev" layout — file browser + editor (default)
//
// Select with: aibox start --layout dev
//
// Structure:
//   ┌──────────────────┬────────────────────────────┐
//   │                  │                            │
//   │  yazi (40%)      │  vim (60%)                 │
//   │                  │                            │
//   │                  │                            │
//   │                  │                            │
//   ├──────────────────┴────────────────────────────┤
//   │  aibox keybar                                 │
//   │  aibox status                                 │
//   └───────────────────────────────────────────────┘
//
//   Tab 1: dev   Tab 2: claude   Tab 3: shell
// =============================================================================

layout {

    tab_template name="aibox-tab" {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
        pane size=1 borderless=true {
            command "bash"
            args "-lc" "exec aibox-status --watch"
        }
    }

    aibox-tab name="dev" focus=true {
        pane split_direction="vertical" {
            pane size="40%" name="files" focus=true {
                command "yazi"
                cwd "/workspace"
            }
            pane size="60%" name="editor" {
                command "vim-loop"
                cwd "/workspace"
            }
        }
    }

    aibox-tab name="claude" {
        pane name="claude" {
            command "claude"
            cwd "/workspace"
        }
    }

    aibox-tab name="shell" {
        pane name="bash" {
            command "bash"
            cwd "/workspace"
        }
    }
}
