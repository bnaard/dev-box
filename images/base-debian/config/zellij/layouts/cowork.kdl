// =============================================================================
// "cowork" layout — side-by-side coding with AI
//
// Select with: aibox start --layout cowork
//
// Structure:
//   ┌──────────────────────┬────────────────────────┐
//   │  yazi (40%)          │                        │
//   │                      │  claude (50%)          │
//   ├──────────────────────┤                        │
//   │  vim (60%)           │                        │
//   │                      │                        │
//   ├──────────────────────┴────────────────────────┤
//   │  aibox keybar                                 │
//   │  aibox status                                 │
//   └───────────────────────────────────────────────┘
//
//   Tab 1: cowork   Tab 2: shell
// =============================================================================

layout {

    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:/usr/local/share/aibox/zellij/aibox-status.wasm" {
                role "keybar"
            }
        }
        pane size=1 borderless=true {
            plugin location="file:/usr/local/share/aibox/zellij/aibox-status.wasm" {
                role "status"
            }
        }
    }

    tab name="cowork" focus=true {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="40%" name="files" focus=true {
                    command "bash"
                    args "-c" "AIBOX_EDITOR_DIR=down exec yazi"
                    cwd "/workspace"
                }
                pane size="60%" name="editor" {
                    command "bash"
                    args "-c" "AIBOX_EDITOR_DIR=down exec vim-loop"
                    cwd "/workspace"
                }
            }
            pane size="50%" name="claude" {
                command "claude"
                cwd "/workspace"
            }
        }
    }

    tab name="shell" {
        pane name="bash" {
            command "bash"
            cwd "/workspace"
        }
    }
}
